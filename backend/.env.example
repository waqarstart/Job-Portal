PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/jobportal
JWT_SECRET=replace_this_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Gmail SMTP for password reset emails.
# EMAIL_USER: your Gmail address
# EMAIL_APP_PASSWORD: NOT your normal Gmail password — a 16-character
# "App Password" you generate at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for your Google account)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Fill these in once you create your LiveAvatar account
# API key: https://app.liveavatar.com/developers
# Production avatar (e.g. Silas) — used when LIVEAVATAR_SANDBOX=false
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=9650a758-1085-4d49-8bf3-f347565ec229
# Optional persona/context ID (production only; skipped in sandbox)
LIVEAVATAR_CONTEXT_ID=
# true = free sandbox (~55s, Wayne only). false = paid avatar + credits
LIVEAVATAR_SANDBOX=true
# Auto-used when LIVEAVATAR_SANDBOX=true (Wayne)
LIVEAVATAR_SANDBOX_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a

# OpenRouter — used for CV evaluation, interview question generation, and summaries
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Google Sign-In — create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 (and your production domain) under
# "Authorized JavaScript origins". This same value also goes in the
# frontend's .env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
