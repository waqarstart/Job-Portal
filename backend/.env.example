PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/jobportal
JWT_SECRET=replace_this_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Gmail SMTP for password reset emails.
# EMAIL_USER: your Gmail address
# EMAIL_APP_PASSWORD: NOT your normal Gmail password — a 16-character
# "App Password" you generate at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for your Google account)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Fill these in once you create your HeyGen account (step 3, later this week)
HEYGEN_API_KEY=
